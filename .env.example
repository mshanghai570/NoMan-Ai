# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Media generation providers (optional). A key set here stays on the server and
# is used before any key pasted in Settings → Generation Providers.
LEONARDO_API_KEY=""
REPLICATE_API_TOKEN=""
BYTEPLUS_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
HUGGINGFACE_API_KEY=""
OPENAI_IMAGE_API_KEY=""

# Roleplay chat: the Kilo AI Gateway is OpenAI-compatible and its :free models
# work without a key, so this can stay empty if you only use free models.
KILO_API_KEY=""
